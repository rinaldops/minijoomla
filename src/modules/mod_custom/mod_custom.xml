<?xml version="1.0" encoding="utf-8"?>
<!-- Generated from the native module catalogue; no PHP installer is provided. -->
<extension type="module" client="site" method="upgrade" xmlns:mj="urn:minijoomla:runtime:1" mj:key="custom-html">
  <name>mod_custom</name>
  <version>0.17.11</version>
  <description>Bloco de HTML sanitizado definido pelo administrador.</description>
  <files>
    <filename module="mod_custom">mod_custom.js</filename>
    <folder>tmpl</folder>
  </files>
  <config>
    <fields name="params">
      <fieldset name="basic" label="HTML personalizado">
        <field name="title" type="text" label="Título exibido (se ausente, usa o título do módulo)" default="" />
        <field name="html" type="textarea" label="Conteúdo HTML" default="" />
      </fieldset>
      <fieldset name="advanced" label="Avançado">
        <field name="moduleClass" type="text" label="Classe CSS do módulo" default="" />
        <field name="headerTag" type="list" label="Tag do título" default="h2">
          <option value="h1">h1</option>
          <option value="h2">h2</option>
          <option value="h3">h3</option>
          <option value="h4">h4</option>
          <option value="h5">h5</option>
          <option value="h6">h6</option>
          <option value="div">div</option>
          <option value="span">span</option>
          <option value="p">p</option>
        </field>
        <field name="headerClass" type="text" label="Classe CSS do título" default="" />
      </fieldset>
    </fields>
  </config>
</extension>
