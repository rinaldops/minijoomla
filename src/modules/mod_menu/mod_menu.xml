<?xml version="1.0" encoding="utf-8"?>
<!-- Generated from the native module catalogue; no PHP installer is provided. -->
<extension type="module" client="site" method="upgrade" xmlns:mj="urn:minijoomla:runtime:1" mj:key="menu">
  <name>mod_menu</name>
  <version>0.17.11</version>
  <description>Menu hierárquico do site.</description>
  <files>
    <filename module="mod_menu">mod_menu.js</filename>
    <folder>tmpl</folder>
  </files>
  <config>
    <fields name="params">
      <fieldset name="basic" label="Menu">
        <field name="startLevel" type="number" label="Nível inicial" min="1" default="1" />
        <field name="endLevel" type="number" label="Nível final" min="0" default="0" />
        <field name="showAllChildren" type="radio" label="Mostrar todos os filhos" default="1">
          <option value="1">Sim</option>
          <option value="0">Não</option>
        </field>
      </fieldset>
      <fieldset name="advanced" label="Avançado">
        <field name="moduleClass" type="text" label="Classe CSS do módulo" default="" />
        <field name="headerTag" type="list" label="Tag do título" default="h2">
          <option value="h1">h1</option>
          <option value="h2">h2</option>
          <option value="h3">h3</option>
          <option value="h4">h4</option>
          <option value="h5">h5</option>
          <option value="h6">h6</option>
          <option value="div">div</option>
          <option value="span">span</option>
          <option value="p">p</option>
        </field>
        <field name="headerClass" type="text" label="Classe CSS do título" default="" />
      </fieldset>
    </fields>
  </config>
</extension>
