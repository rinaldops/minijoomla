<?xml version="1.0" encoding="utf-8"?>
<!-- Generated from the native module catalogue; no PHP installer is provided. -->
<extension type="module" client="site" method="upgrade" xmlns:mj="urn:minijoomla:runtime:1" mj:key="login">
  <name>mod_login</name>
  <version>0.17.11</version>
  <description>Mostra o usuário da sessão do host ou um link de entrada; nunca coleta senha.</description>
  <files>
    <filename module="mod_login">mod_login.js</filename>
    <folder>tmpl</folder>
  </files>
  <config>
    <fields name="params">
      <fieldset name="basic" label="Login / sessão">
        <field name="loginUrl" type="text" label="URL de entrada" default="" />
        <field name="loginText" type="text" label="Texto do link" default="Entrar" />
        <field name="greeting" type="text" label="Saudação" default="Olá" />
      </fieldset>
      <fieldset name="advanced" label="Avançado">
        <field name="moduleClass" type="text" label="Classe CSS do módulo" default="" />
        <field name="headerTag" type="list" label="Tag do título" default="h2">
          <option value="h1">h1</option>
          <option value="h2">h2</option>
          <option value="h3">h3</option>
          <option value="h4">h4</option>
          <option value="h5">h5</option>
          <option value="h6">h6</option>
          <option value="div">div</option>
          <option value="span">span</option>
          <option value="p">p</option>
        </field>
        <field name="headerClass" type="text" label="Classe CSS do título" default="" />
      </fieldset>
    </fields>
  </config>
</extension>
