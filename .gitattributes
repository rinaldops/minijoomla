*.js text eol=lf
*.mjs text eol=lf
*.css text eol=lf
*.xml text eol=lf
*.md text eol=lf
src/media/vendor/tinymce/** -text
src/libraries/vendor/parse-xml/** -text
src/media/sampledata/joomla-blog/** -text
scripts/documentation-frozen-build/** -text whitespace=cr-at-eol

# O stage empacota os bytes de src/ tal como estao no disco, e o readback do
# deploy compara SHA-256 dos bytes carregados. A release publicada 0.17.13
# atesta CRLF nesses caminhos no proprio manifest; sem -text o Git converte
# para LF no add/checkout e o pacote deixa de reproduzir os bytes publicados.
# -text preserva o EOL original; whitespace=cr-at-eol evita que o \r final seja
# lido como espaco em branco por `git diff --check`.
LICENSE.md -text whitespace=cr-at-eol
src/index.js -text whitespace=cr-at-eol
